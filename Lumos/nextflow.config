// nextflow.config

process.executor = 'slurm'

//cleanup after successful run
cleanup = true

//default output folder, could be changed with -output-dir XXX
outputDir = 'lumos_out'

workflow {
    output {
        mode = 'copy'
    }
}

timeline {
  enabled   = true
  overwrite = true
  file      = "work/pipeline.timeline.html"
}

report {
  enabled   = true
  overwrite = true
  file      = "work/pipeline.report.html"
}

trace {
  enabled   = true
  overwrite = true
  file      = "work/pipeline.trace.txt"
  fields    = 'task_id,process,tag,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem,rss,vmem'
}

conda {
  enabled       = true
  useMamba      = true
  cacheDir      = "/leonardo_work/IscrC_KREIOS/conda_cachedir/tducci00/nf"

}
singularity {
    enabled = true
    autoPullMode = true
    autoMounts = true
    cacheDir = "/leonardo_work/IscrC_KREIOS/singularity_cachedir"
    envWhitelist = 'https_proxy,http_proxy,ftp_proxy,DISPLAY,SLURM_JOB_ID,SINGULARITY_BINDPATH,MPLCONFIGDIR'
    pullTimeout = '30 min'
}

//Fail on any error in bash script
process.shell = ['/bin/bash', '-euo', 'pipefail']

profiles {
    slurm {
        executor {
            name = 'slurm'
        }
        process {
            clusterOptions = '--account=IscrC_KREIOS -p boost_usr_prod -q normal'

            withName: 'deepsomaticTumorOnly' {
                clusterOptions = '--account=IscrC_KREIOS -p boost_usr_prod -N 3'
            }

            withName: 'callClair3' {
                clusterOptions = '--account=IscrC_KREIOS -p boost_usr_prod'
            }

        }
    }
}
